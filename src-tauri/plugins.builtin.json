{
  "schema_version": 1,
  "plugins": [
    {
      "id": "calibre",
      "name": "格式转换引擎",
      "description": "基于 Calibre 便携版，在书架里把电子书转换为 EPUB / MOBI / AZW3 / PDF / TXT / DOCX。本地转换，不上传任何文件。",
      "capability": "convert",
      "publisher": "Kovid Goyal",
      "homepage": "https://calibre-ebook.com",
      "license": "GPL-3.0",
      "targets": {
        "windows": {
          "download": {
            "resolver": "calibre-latest",
            "sources": [
              { "name": "官方源", "url": "https://calibre-ebook.com/dist/portable" }
            ],
            "min_bytes": 52428800
          },
          "install": {
            "kind": "sfx-exe",
            "args": ["{dir}"],
            "max_path_len": 40
          },
          "entry": "Calibre Portable/Calibre/ebook-convert.exe"
        }
      },
      "inputs": [
        "epub", "mobi", "azw3", "azw", "pdf", "txt", "fb2",
        "docx", "rtf", "cbz", "cbr", "djvu", "html", "lit", "pdb"
      ],
      "outputs": ["epub", "mobi", "azw3", "pdf", "txt", "docx"],
      "exec": {
        "args": ["{input}", "{output}"],
        "progress_regex": "^\\s*(\\d{1,3})%",
        "actions": [
          {
            "id": "polish",
            "name": "瘦身优化",
            "description": "无损压缩书里的图片、只嵌入用到的字体、删掉无用 CSS。图文书常能小一半，排版不变。",
            "inputs": ["epub", "azw3"],
            "entry": "Calibre Portable/Calibre/ebook-polish.exe",
            "args": [
              "--compress-images",
              "--subset-fonts",
              "--remove-unused-css",
              "{input}",
              "{output}"
            ],
            "output_suffix": "-瘦身"
          }
        ]
      }
    },
    {
      "id": "pdfcpu",
      "name": "PDF 工具箱",
      "description": "本地处理 PDF：压缩瘦身（清理冗余的嵌入字体与重复图片资源）、解除加密与权限限制。单文件工具，全程离线。",
      "capability": "pdf-tools",
      "publisher": "pdfcpu",
      "homepage": "https://pdfcpu.io",
      "license": "Apache-2.0",
      "inputs": ["pdf"],
      "outputs": ["pdf"],
      "targets": {
        "windows": {
          "download": {
            "sources": [
              {
                "name": "GitHub",
                "url": "https://github.com/pdfcpu/pdfcpu/releases/download/v0.13.0/pdfcpu_0.13.0_Windows_x86_64.zip"
              }
            ],
            "sha256": "53add9ba4bd6fa754e0e12a856c7ede6030a17b67d49f634ae1011424d75fced",
            "min_bytes": 3145728
          },
          "install": {
            "kind": "zip"
          },
          "entry": "pdfcpu_0.13.0_Windows_x86_64/pdfcpu.exe"
        }
      },
      "exec": {
        "actions": [
          {
            "id": "optimize",
            "name": "压缩瘦身",
            "description": "清理 PDF 里冗余的嵌入字体和重复图片资源，页面内容不变，文件通常能小一截。",
            "args": ["optimize", "-c", "disable", "--offline", "{input}", "{output}"],
            "output_suffix": "-瘦身"
          },
          {
            "id": "decrypt",
            "name": "解除权限限制",
            "description": "去掉 PDF 上「禁止复制/打印/批注」的权限限制。请只对你有权处理的文件使用。",
            "args": ["decrypt", "-c", "disable", "--offline", "{input}", "{output}"],
            "output_suffix": "-已解锁"
          }
        ]
      }
    },
    {
      "id": "umi-ocr",
      "name": "OCR 文字识别",
      "description": "把扫描版 PDF 变成双层可搜索 PDF：保留原版式，在图片下叠加隐藏文本层，从此能搜索、能选中复制。内置中英日韩等语言库，完全离线，文件不出网。",
      "capability": "ocr",
      "publisher": "hiroi-sora",
      "homepage": "https://github.com/hiroi-sora/Umi-OCR",
      "license": "MIT",
      "inputs": ["pdf", "epub", "mobi", "xps", "cbz"],
      "outputs": ["pdf"],
      "targets": {
        "windows": {
          "download": {
            "sources": [
              {
                "name": "GitHub",
                "url": "https://github.com/hiroi-sora/Umi-OCR/releases/download/v2.1.5/Umi-OCR_Rapid_v2.1.5.7z.exe"
              }
            ],
            "sha256": "659c55896c32a5e019dc7bde1713d0e5c73186a2c653bed84c4480fa1795b722",
            "min_bytes": 52428800
          },
          "install": {
            "kind": "sfx-exe",
            "args": ["-o{dir}", "-y"]
          },
          "entry": "Umi-OCR_Rapid_v2.1.5/Umi-OCR.exe"
        }
      },
      "service": {
        "port": 1224,
        "health": "/api/doc/get_options",
        "post_start_args": ["--hide"],
        "quit_args": ["--quit"],
        "startup_timeout_secs": 90
      }
    },
    {
      "id": "pandoc",
      "name": "文档转换（Pandoc）",
      "description": "在 Word、Markdown、HTML、ODT 与 EPUB 之间互转：把 Word 文档或网页做成电子书，或把电子书导出为 Markdown / Word 方便摘录编辑。本地转换，全程离线。",
      "capability": "doc-convert",
      "publisher": "John MacFarlane",
      "homepage": "https://pandoc.org",
      "license": "GPL-2.0-or-later",
      "inputs": ["docx", "odt", "md", "html", "epub"],
      "outputs": ["epub", "docx", "md"],
      "targets": {
        "windows": {
          "download": {
            "sources": [
              {
                "name": "GitHub",
                "url": "https://github.com/jgm/pandoc/releases/download/3.12/pandoc-3.12-windows-x86_64.zip"
              }
            ],
            "sha256": "2a77ebc2517d13e95056e76b1cd5b574cfe958ac61aa6058117d80c22ca19b79",
            "min_bytes": 31457280
          },
          "install": {
            "kind": "zip"
          },
          "entry": "pandoc-3.12/pandoc.exe"
        }
      },
      "exec": {
        "actions": [
          {
            "id": "to-epub",
            "name": "转为 EPUB 电子书",
            "description": "把 Word / Markdown / HTML / ODT 文档转成 EPUB，可直接用阅读器打开或传到手机。",
            "inputs": ["docx", "odt", "md", "html"],
            "args": ["{input}", "-o", "{output}"],
            "output_ext": "epub"
          },
          {
            "id": "to-docx",
            "name": "导出为 Word",
            "description": "把 EPUB / Markdown / HTML / ODT 导出为 Word 文档，方便批注和编辑。",
            "inputs": ["epub", "md", "html", "odt"],
            "args": ["{input}", "-o", "{output}"],
            "output_ext": "docx"
          },
          {
            "id": "to-markdown",
            "name": "导出为 Markdown",
            "description": "把 EPUB / Word / HTML / ODT 导出为纯净的 Markdown，适合做读书笔记或导入笔记软件。",
            "inputs": ["epub", "docx", "html", "odt"],
            "args": ["{input}", "-t", "gfm-raw_html", "-o", "{output}"],
            "output_ext": "md"
          }
        ]
      }
    },
    {
      "id": "qpdf",
      "name": "PDF 修复（qpdf）",
      "description": "修复打不开、显示不全或报错的 PDF：重建损坏的交叉引用表并重新写出一份结构完好的文件，原文件保留不动。",
      "capability": "pdf-tools",
      "publisher": "Jay Berkenbilt",
      "homepage": "https://qpdf.sourceforge.io",
      "license": "Apache-2.0",
      "inputs": ["pdf"],
      "outputs": ["pdf"],
      "targets": {
        "windows": {
          "download": {
            "sources": [
              {
                "name": "GitHub",
                "url": "https://github.com/qpdf/qpdf/releases/download/v12.4.2/qpdf-12.4.2-msvc64.zip"
              }
            ],
            "sha256": "db87077e683630c1217e0e8f9a20a9749d952ab676e881c3689187763a5de25d",
            "min_bytes": 20971520
          },
          "install": {
            "kind": "zip"
          },
          "entry": "qpdf-12.4.2-msvc64/bin/qpdf.exe"
        }
      },
      "exec": {
        "actions": [
          {
            "id": "repair",
            "name": "修复损坏的 PDF",
            "description": "重建损坏的 PDF 结构，生成一份新的可正常打开的文件。",
            "args": ["--warning-exit-0", "{input}", "{output}"],
            "output_suffix": "-修复"
          }
        ]
      }
    },
    {
      "id": "poppler",
      "name": "PDF 文字提取（Poppler）",
      "description": "把 PDF 里的文字提取成 TXT，方便全文搜索、复制摘录或导入其他工具。扫描版 PDF 没有文字层，请先用「OCR 文字识别」处理。",
      "capability": "pdf-tools",
      "publisher": "Poppler / oschwartz10612",
      "homepage": "https://github.com/oschwartz10612/poppler-windows",
      "license": "GPL-2.0",
      "inputs": ["pdf"],
      "outputs": ["txt"],
      "targets": {
        "windows": {
          "download": {
            "sources": [
              {
                "name": "GitHub",
                "url": "https://github.com/oschwartz10612/poppler-windows/releases/download/v26.09.0-0/Release-26.09.0-0.zip"
              }
            ],
            "sha256": "7a6f256a0ddf7536182246a5733331bf4677cbcc34f4663774947ad34556c8d0",
            "min_bytes": 31457280
          },
          "install": {
            "kind": "zip"
          },
          "entry": "poppler-26.09.0/Library/bin/pdftotext.exe"
        }
      },
      "exec": {
        "actions": [
          {
            "id": "extract-text",
            "name": "提取文字为 TXT",
            "description": "按阅读顺序提取 PDF 中的文字，保存为 UTF-8 编码的 TXT。",
            "args": ["-enc", "UTF-8", "{input}", "{output}"],
            "output_ext": "txt"
          }
        ]
      }
    },
    {
      "id": "opencc",
      "name": "简繁转换（OpenCC）",
      "description": "TXT 电子书简体、繁体互转，按词组转换而非逐字替换（如「软件」→「軟件」）。仅支持 UTF-8 编码的 TXT，GBK 编码的文件会提示错误。",
      "capability": "text-tools",
      "publisher": "BYVoid",
      "homepage": "https://github.com/BYVoid/OpenCC",
      "license": "Apache-2.0",
      "inputs": ["txt"],
      "outputs": ["txt"],
      "targets": {
        "windows": {
          "download": {
            "sources": [
              {
                "name": "GitHub",
                "url": "https://github.com/BYVoid/OpenCC/releases/download/ver.1.4.2/OpenCC-1.4.2-windows-x64-portable.zip"
              }
            ],
            "sha256": "dab0142ff6401219a5e556cee215323753eeac38752dde4cfddf8035746605f1",
            "min_bytes": 4194304
          },
          "install": {
            "kind": "zip"
          },
          "entry": "bin/opencc.exe"
        }
      },
      "exec": {
        "actions": [
          {
            "id": "s2t",
            "name": "简体转繁体",
            "description": "把简体中文 TXT 转换为繁体中文。",
            "args": ["-i", "{input}", "-o", "{output}", "-c", "s2t.json"],
            "output_suffix": "-繁体"
          },
          {
            "id": "t2s",
            "name": "繁体转简体",
            "description": "把繁体中文 TXT 转换为简体中文。",
            "args": ["-i", "{input}", "-o", "{output}", "-c", "t2s.json"],
            "output_suffix": "-简体"
          }
        ]
      }
    }
  ]
}
